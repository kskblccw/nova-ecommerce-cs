# ── 应用 ───────────────────────────────────────────────
APP_ENV=dev
APP_NAME=电商智能客服
API_PREFIX=/api
LOG_LEVEL=INFO

# ── 数据库 ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/ecommerce_cs
CHECKPOINTER_BACKEND=postgres

# ── 鉴权 ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# 生产环境必须为 true
COOKIE_SECURE=false

# ── LLM / Embedding ────────────────────────────────────
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# ── 可观测性（LangSmith 全链路追踪）────────────────────
# 开启后每次对话生成 trace：路由、工具调用、LLM 耗时与失败原因
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nova-cs
# 留空使用官方 https://api.smith.langchain.com
LANGSMITH_ENDPOINT=

# ── 前端跨域（逗号分隔）────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 业务参数 ───────────────────────────────────────────
HISTORY_WINDOW=12
MAX_AGENT_STEPS=6
HUMAN_HOTLINE=400-888-8888
ADMIN_PHONE=13900000000

# ── 限流与登录锁定 ─────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_DAY=500
MAX_CONCURRENT_STREAMS_PER_USER=1
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 同一 IP 的失败上限，避免单个网络暴力尝试多个账号
LOGIN_MAX_IP_FAILURES=20
LOGIN_IP_LOCK_MINUTES=15
# 为空时使用进程内限流；生产环境建议配置 Redis
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_KEY_PREFIX=cs:rl
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1
# 反向代理场景可开启；直连公网时保持 false，避免伪造 X-Forwarded-For
TRUST_FORWARDED_FOR=false

# ── RAG 双路召回 ───────────────────────────────────────
# auto：有 pgvector 扩展与 embedding_vec 列时走 HNSW，否则降级 JSONB + numpy
RAG_VECTOR_BACKEND=auto
RAG_VECTOR_CANDIDATES=12
RAG_KEYWORD_CANDIDATES=12
RAG_RRF_K=10
RAG_VECTOR_WEIGHT=2.0
RAG_KEYWORD_WEIGHT=1.0
RAG_KEYWORD_MAX_TERMS=8

# ── Agent 护栏、降级与熔断 ─────────────────────────────
# 0 表示按 MAX_AGENT_STEPS 自动推导
AGENT_RECURSION_LIMIT=0
AGENT_TIMEOUT_SECONDS=120
MAX_TOOL_CALLS=8
TOOL_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
LLM_FAILURE_THRESHOLD=5
LLM_COOLDOWN_SECONDS=60

# ── 数据保留与清理 ─────────────────────────────────────
PENDING_ACTION_TTL_MINUTES=30
AUTH_SESSION_RETENTION_DAYS=30
RETRIEVAL_LOG_RETENTION_DAYS=30
CHECKPOINT_RETENTION_DAYS=30
CLEANUP_INTERVAL_MINUTES=60
CLEANUP_ON_STARTUP=true

# ── 记忆压缩节流 ───────────────────────────────────────
MEMORY_MIN_INTERVAL_MINUTES=5
